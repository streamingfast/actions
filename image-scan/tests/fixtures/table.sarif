      {"id": "CVE-2025-3333", "properties": {"security-severity": "9.4"}, "help": {"text": "Vulnerability CVE-2025-3333\nSeverity: CRITICAL\nPackage: pkg:npm/lodash@4.17.0\nAffected version: 4.17.0\nFixed version: 4.17.21\n"}},
